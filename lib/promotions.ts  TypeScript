export interface Promotion {
  id: string;
  name: string;
  slug: string;
  discount_type: 'PERCENTAGE' | 'FIXED';
  discount_value: number;
  target_category?: string;
  target_product_id?: string;
  start_at: string;
  end_at: string;
  is_enabled: boolean;
  priority: number;
}

export function calculateDiscountedPrice(originalPrice: number, activePromotions: Promotion[], category?: string, productId?: string): { finalPrice: number; appliedPromotion: Promotion | null } {
  const now = new Date().getTime();
  
  // Filter eligible and active promotions
  const eligible = activePromotions.filter(p => {
    const isActive = p.is_enabled && new Date(p.start_at).getTime() <= now && new Date(p.end_at).getTime() > now;
    const matchesCategory = p.target_category ? p.target_category === category : true;
    const matchesProduct = p.target_product_id ? p.target_product_id === productId : true;
    return isActive && (matchesCategory || matchesProduct);
  });

  if (eligible.length === 0) return { finalPrice: originalPrice, appliedPromotion: null };

  // Priority logic: Highest priority wins. If tie, highest discount value wins.
  eligible.sort((a, b) => b.priority - a.priority || b.discount_value - a.discount_value);
  const bestPromo = eligible[0];

  let finalPrice = originalPrice;
  if (bestPromo.discount_type === 'PERCENTAGE') {
    finalPrice = originalPrice - (originalPrice * (bestPromo.discount_value / 100));
  } else if (bestPromo.discount_type === 'FIXED') {
    finalPrice = originalPrice - bestPromo.discount_value;
  }

  // Safety constraint: Never negative
  return { 
    finalPrice: Math.max(finalPrice, 0), 
    appliedPromotion: bestPromo 
  };
}